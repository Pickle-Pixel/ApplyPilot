# Container files MUST keep LF endings regardless of the checkout platform -- a CRLF in a
# shell shebang or the Dockerfile breaks the Linux build/run ("bad interpreter: ...^M").
*.sh        text eol=lf
Dockerfile  text eol=lf
deploy/**   text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
tests/fixtures/canonical-brain/*.json text eol=lf
src/applypilot/fleet/migrations/*.json text eol=lf
src/applypilot/fleet/migrations/*.sql text eol=lf
src/applypilot/brain/schema_*.sql text eol=lf
# The predecessor byte bundle is exact, content-addressed Git blob bytes. Never
# normalize (CRLF/LF) -- that would change the blob id and break the pin.
src/applypilot/fleet/migrations/predecessor/[0-9a-f]* -text
Dockerfile.authority-migrator text eol=lf
railway.toml text eol=lf
scripts/run-private-authority-migrator.py text eol=lf
deploy/authority-migrator/package-manifest.json text eol=lf
