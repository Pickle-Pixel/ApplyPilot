# Private authority-migrator image. Its single job is to apply the append-only
# fleet migration manifest (src/applypilot/fleet/migrations/manifest-v1.json) to
# an EXPLICIT private target and nothing else.
#
# It bakes no target identity, no credential, and no default DSN. The entrypoint,
# scripts/run-private-authority-migrator.py, requires the operator to name the
# target DSN environment variable and to state the exact database name and
# PostgreSQL system_identifier at run time; it fails closed otherwise.
FROM python:3.12-slim-bookworm
USER root

# Only the Postgres driver is needed: the wrapper imports applypilot from the
# copied source tree (sys.path), so there is no editable install and no browser.
RUN pip install --no-cache-dir "psycopg[binary]==3.2.3"

WORKDIR /app

# Copy ONLY the tracked files this migrator needs. .git, .env / .env.*, tests,
# docs, and any untracked local payload are stripped from the build context by
# .dockerignore; nothing here re-adds them, and there is no `COPY . /app`.
#
# The wrapper resolves its repository root to this WORKDIR (/app) and, before any
# migration, calls verify_package_manifest, which binds three deployment wrappers
# by hash *relative to that root*: Dockerfile.authority-migrator, railway.toml,
# and scripts/run-private-authority-migrator.py. All three must therefore be
# present in the image at their exact manifest-relative paths, or startup fails
# closed with a missing-bound-wrapper error. That is why the two deployment
# descriptors below are copied alongside the wrapper -- they are inert provenance
# artifacts here, never re-read as build config by the running container.
COPY pyproject.toml /app/pyproject.toml
COPY src /app/src
COPY scripts/run-private-authority-migrator.py /app/scripts/run-private-authority-migrator.py
COPY railway.toml /app/railway.toml
COPY Dockerfile.authority-migrator /app/Dockerfile.authority-migrator
COPY deploy/authority-migrator/package-manifest.json /app/deploy/authority-migrator/package-manifest.json

ENV PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONDONTWRITEBYTECODE=1

# No CMD arguments: the operator MUST pass --target-dsn-env,
# --expected-database-name, and --expected-system-identifier explicitly (see
# railway.toml). Running the image with no arguments prints usage and exits
# non-zero rather than guessing a target.
ENTRYPOINT ["python3", "/app/scripts/run-private-authority-migrator.py"]
